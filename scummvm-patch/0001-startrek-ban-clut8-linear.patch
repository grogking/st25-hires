+
+void Graphics::writeScreenIndexed(int linearOffset, byte color) {
+	if (!_lockedScreen)
+		return;
+	if (linearOffset < 0 || linearOffset >= SCREEN_WIDTH * SCREEN_HEIGHT)
+		return;
+
+	const int x = linearOffset % SCREEN_WIDTH;
+	const int y = linearOffset / SCREEN_WIDTH;
+
+	if (_lockedScreen->format.bytesPerPixel == 1) {
+		byte *p = (byte *)_lockedScreen->getBasePtr(x, y);
+		*p = color;
+		return;
+	}
+
+	// VGA palette is 6-bit stored in _palData; expand to 8-bit for truecolor backends.
+	byte r = 0, g = 0, b = 0;
+	if (_palData) {
+		r = _palData[color * 3] << 2;
+		g = _palData[color * 3 + 1] << 2;
+		b = _palData[color * 3 + 2] << 2;
+	}
+	_lockedScreen->setPixel(x, y, _lockedScreen->format.RGBToColor(r, g, b));
 }
 
